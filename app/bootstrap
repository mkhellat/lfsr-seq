#!/bin/sh
# bootstrap - Guided first-time setup for lfsr-seq
#
# Runs a configure-style system/dependency check (platform, Python, pip,
# SageMath), then delegates the actual install/clean/uninstall work to the
# Makefile in this directory, so there is exactly one place (the Makefile)
# that knows how to build, test, or tear down the package. This script's
# job is the guided pre-flight check and first-run experience, not
# reimplementing what make already does.
#
# Usage:
#   ./bootstrap [--dev] [--skip-sagemath-check] [--no-venv] [--clean] [--uninstall] [--help]
#
# Options:
#   --dev                 Install with development dependencies
#   --skip-sagemath-check Skip SageMath availability check
#   --no-venv             Skip virtual environment creation (install system-wide)
#   --clean               Run "make distclean" (removes build artifacts and .venv)
#   --uninstall           Run "make uninstall"
#   --help                Show this help message
#
# Exit codes:
#   0 - Installation successful
#   1 - Installation failed

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"
INSTALL_DEV=false
SKIP_SAGEMATH_CHECK=false
CREATE_VENV=true
CLEAN_ONLY=false
UNINSTALL_ONLY=false

cd "$PROJECT_ROOT"

# Parse command line arguments
while [ $# -gt 0 ]; do
    case "$1" in
        --dev)
            INSTALL_DEV=true
            shift
            ;;
        --skip-sagemath-check)
            SKIP_SAGEMATH_CHECK=true
            shift
            ;;
        --no-venv)
            CREATE_VENV=false
            shift
            ;;
        --clean)
            CLEAN_ONLY=true
            shift
            ;;
        --uninstall)
            UNINSTALL_ONLY=true
            shift
            ;;
        --help|-h)
            echo "bootstrap - Guided first-time setup for lfsr-seq"
            echo ""
            echo "Usage: $0 [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --dev                  Install with development dependencies"
            echo "  --skip-sagemath-check  Skip SageMath availability check"
            echo "  --no-venv              Skip virtual environment creation"
            echo "  --clean                Run 'make distclean' (build artifacts + .venv)"
            echo "  --uninstall            Run 'make uninstall'"
            echo "  --help, -h             Show this help message"
            echo ""
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

echo "=========================================="
echo "lfsr-seq Bootstrap"
echo "=========================================="
echo ""

# --------------------------------------------------------------------------
# System / environment probe (configure-style)
#
# This mirrors what an autoconf-generated `configure` script would report
# before building: platform identity, toolchain versions, and the
# properties of this environment that determine how the rest of bootstrap
# (and make) will behave. Nothing here mutates anything -- it is purely
# diagnostic, so its output is safe to paste into a bug report.
# --------------------------------------------------------------------------
echo "Checking build environment..."
echo ""

UNAME_S="$(uname -s 2>/dev/null || echo unknown)"
UNAME_M="$(uname -m 2>/dev/null || echo unknown)"
UNAME_R="$(uname -r 2>/dev/null || echo unknown)"

case "$UNAME_S" in
    Linux)
        PLATFORM_FAMILY="GNU/Linux"
        if [ -r /etc/os-release ]; then
            DISTRO_NAME="$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-$NAME}")"
        else
            DISTRO_NAME="unknown distribution"
        fi
        echo "  Platform      : $PLATFORM_FAMILY ($DISTRO_NAME)"
        ;;
    Darwin)
        PLATFORM_FAMILY="macOS"
        MACOS_VERSION="$(sw_vers -productVersion 2>/dev/null || echo unknown)"
        echo "  Platform      : $PLATFORM_FAMILY $MACOS_VERSION"
        ;;
    FreeBSD|OpenBSD|NetBSD|DragonFly)
        PLATFORM_FAMILY="BSD"
        echo "  Platform      : $UNAME_S (BSD family)"
        ;;
    *)
        PLATFORM_FAMILY="unknown"
        echo "  Platform      : $UNAME_S (untested; POSIX sh assumed)"
        ;;
esac
echo "  Kernel        : $UNAME_S $UNAME_R"
echo "  Architecture  : $UNAME_M"

# Shell actually running this script (informational -- bootstrap requires
# only POSIX sh features, but it helps to know what interpreted it).
if [ -n "${ZSH_VERSION:-}" ]; then
    echo "  Shell         : zsh $ZSH_VERSION"
elif [ -n "${BASH_VERSION:-}" ]; then
    echo "  Shell         : bash $BASH_VERSION"
else
    echo "  Shell         : $(readlink /proc/$$/exe 2>/dev/null || echo "$0" 2>/dev/null || echo unknown)"
fi

echo ""

# Handle clean option -- delegate to make, don't reimplement its logic here
if [ "$CLEAN_ONLY" = "true" ]; then
    echo "Delegating to 'make distclean' (removes build artifacts and .venv)..."
    echo ""
    make -C "$PROJECT_ROOT" distclean
    echo ""
    echo "=========================================="
    echo "Clean completed successfully!"
    echo "=========================================="
    exit 0
fi

# Handle uninstall option -- delegate to make
if [ "$UNINSTALL_ONLY" = "true" ]; then
    echo "Delegating to 'make uninstall'..."
    echo ""
    make -C "$PROJECT_ROOT" uninstall
    exit 0
fi

# Step 1: Check Python
echo "[1/6] Checking Python installation..."
if ! command -v python3 >/dev/null 2>&1; then
    echo "  ✗ ERROR: python3 not found"
    echo "    Please install Python 3.8 or higher"
    exit 1
fi

PYTHON_VERSION=$(python3 --version 2>&1 | awk '{print $2}')
PYTHON_MAJOR=$(echo "$PYTHON_VERSION" | cut -d. -f1)
PYTHON_MINOR=$(echo "$PYTHON_VERSION" | cut -d. -f2)

if [ "$PYTHON_MAJOR" -lt 3 ] || ([ "$PYTHON_MAJOR" -eq 3 ] && [ "$PYTHON_MINOR" -lt 8 ]); then
    echo "  ✗ ERROR: Python 3.8+ required, found $PYTHON_VERSION"
    exit 1
fi
echo "  ✓ Python $PYTHON_VERSION found ($(command -v python3))"

# Step 2: Check pip
echo "[2/6] Checking pip installation..."
if ! python3 -m pip --version >/dev/null 2>&1; then
    echo "  ✗ ERROR: pip not found"
    echo "    Installing pip..."
    python3 -m ensurepip --upgrade || {
        echo "  ✗ ERROR: Failed to install pip"
        echo "    Please install pip manually:"
        echo "      Debian/Ubuntu: sudo apt-get install python3-pip"
        echo "      Fedora/RHEL:   sudo dnf install python3-pip"
        echo "      Arch Linux:    sudo pacman -S python-pip"
        echo "      macOS:         python3 -m ensurepip, or reinstall via brew/python.org"
        exit 1
    }
fi
echo "  ✓ pip available"

# Step 3: Check make (required -- bootstrap delegates to it from here on)
echo "[3/7] Checking make..."
if ! command -v make >/dev/null 2>&1; then
    echo "  ✗ ERROR: make not found"
    echo "    bootstrap delegates build/install steps to make; please install it:"
    echo "      Debian/Ubuntu: sudo apt-get install make"
    echo "      Fedora/RHEL:   sudo dnf install make"
    echo "      Arch Linux:    sudo pacman -S make"
    echo "      macOS:         xcode-select --install (or: brew install make)"
    echo "      FreeBSD/OpenBSD/NetBSD: make is part of the base system"
    exit 1
fi
echo "  ✓ make available ($(command -v make))"

# Step 4: Create virtual environment (default, PEP 668 compliant)
if [ "$CREATE_VENV" = "true" ]; then
    echo "[4/7] Creating virtual environment (PEP 668 compliant)..."
    if [ -d "$PROJECT_ROOT/.venv" ]; then
        echo "  ⚠ Virtual environment already exists at .venv"
        echo "  Using existing virtual environment"
    else
        python3 -m venv "$PROJECT_ROOT/.venv"
        echo "  ✓ Virtual environment created at .venv"
    fi
    . "$PROJECT_ROOT/.venv/bin/activate"
    echo "  ✓ Virtual environment activated"
    echo "  Note: This ensures PEP 668 compliance (no system-wide package installation)"
else
    echo "[4/7] Skipping virtual environment creation (--no-venv)"
    if [ -z "$VIRTUAL_ENV" ]; then
        echo "  ⚠ WARNING: Not in a virtual environment"
        echo "    Packages will be installed system-wide (may fail on PEP 668 systems)"
        echo "    This is not recommended and may require --break-system-packages flag"
    fi
fi

# Step 5: Check SageMath (optional, but required at runtime)
echo "[5/7] Checking SageMath..."
if [ "$SKIP_SAGEMATH_CHECK" = "false" ]; then
    SAGE_FOUND=false
    SAGE_VERSION="unknown"

    if python3 -c "import sage.all" 2>/dev/null; then
        SAGE_VERSION=$(python3 -c "import sage; print(sage.__version__)" 2>/dev/null || echo "unknown")
        SAGE_FOUND=true
    elif command -v sage >/dev/null 2>&1; then
        if sage -c "import sage.all" >/dev/null 2>&1; then
            SAGE_VERSION=$(sage --version 2>/dev/null | head -n1 || echo "unknown")
            SAGE_FOUND=true
        fi
    fi

    if [ "$SAGE_FOUND" = "true" ]; then
        echo "  ✓ SageMath $SAGE_VERSION found"
    else
        echo "  ⚠ WARNING: SageMath not found"
        echo "    lfsr-seq requires SageMath to run (it is not available on PyPI"
        echo "    and cannot be installed into this virtual environment via pip)."
        echo "    Install SageMath via your system package manager:"
        echo "      Debian/Ubuntu:          sudo apt-get install sagemath"
        echo "      Fedora/RHEL:            sudo dnf install sagemath"
        echo "      Arch Linux:             sudo pacman -S sagemath"
        echo "      macOS (Homebrew):       brew install sagemath"
        echo "      Conda (any platform):   conda install -c conda-forge sage"
        echo "      FreeBSD/OpenBSD/NetBSD: check your ports tree / pkg repository;"
        echo "                              SageMath packaging on BSD is inconsistent,"
        echo "                              conda-forge is the most reliable fallback"
        echo ""
        read -p "    Continue installation anyway? [y/N] " -n 1 -r
        echo
        if [ ! "$REPLY" = "y" ] && [ ! "$REPLY" = "Y" ]; then
            echo "    Installation cancelled"
            exit 1
        fi
    fi
else
    echo "  ⏭ Skipped (--skip-sagemath-check)"
fi

# Step 6: Delegate the actual install to make
echo "[6/7] Installing lfsr-seq (via make)..."
if [ "$INSTALL_DEV" = "true" ]; then
    make -C "$PROJECT_ROOT" install-dev
else
    make -C "$PROJECT_ROOT" install
fi

# Step 7: Verify installation
echo "[7/7] Verifying installation (via make smoke-test)..."
if make -C "$PROJECT_ROOT" smoke-test >/dev/null 2>&1; then
    echo "  ✓ Smoke tests passed"
else
    echo "  ⚠ WARNING: Some smoke tests failed (this may be expected, e.g. if"
    echo "    SageMath is unavailable)"
    echo "    Run 'make smoke-test' for details"
fi

echo ""
echo "=========================================="
echo "Installation completed successfully!"
echo "=========================================="
echo ""
if [ "$CREATE_VENV" = "true" ]; then
    echo "Virtual environment created at .venv"
    echo ""
    echo "To activate the virtual environment:"
    echo "  source .venv/bin/activate"
    echo ""
    echo "To deactivate (when done):"
    echo "  deactivate"
    echo ""
fi
echo "Next steps:"
echo "  1. Run environment check:  make check-env"
echo "  2. Run smoke tests:        make smoke-test"
echo "  3. Try the tool:           lfsr-seq scripts/smoke-test-input.csv 2"
echo ""
if [ "$INSTALL_DEV" = "true" ]; then
    echo "Development tools available:"
    echo "  - Run tests:              make test"
    echo "  - Format code:            make format"
    echo "  - Run linting:            make lint"
    echo "  - Type checking:          make type-check"
    echo ""
fi
echo "For more information, see README.md"
echo ""
